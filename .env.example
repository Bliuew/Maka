# Copy to .env for local development (docker compose up -d starts Postgres).
DATABASE_URL=postgres://maka:maka@localhost:5432/maka

# Optional in development, REQUIRED in production: S3-compatible media storage.
# Uncomment for the local emulator (docker compose --profile s3 up -d),
# or point these at Cloudflare R2 / Backblaze B2 / AWS S3.
# S3_BUCKET=maka-media
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=1
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_CREATE_BUCKET=1
