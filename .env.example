# Copy to .env for local development (docker compose up -d starts these services).
DATABASE_URL=postgres://maka:maka@localhost:5432/maka
S3_BUCKET=maka-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1
S3_ACCESS_KEY_ID=maka
S3_SECRET_ACCESS_KEY=maka-dev-secret
S3_CREATE_BUCKET=1
